{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SecurityService": {
    "BaseUrl": "http://localhost:5239/"
  },
  "JwtSettings": {
    "Issuer": "TuIssuer",
    "Audience": "TuAudience",
    "SecretKey": "BAWP7kt4n95Evq8dzF6DHCQcLpamjNrx",
    "TokenExpirationMinutes": 1,
    "TokenInactivityMinutes": 3
  },
  "ReverseProxy": {
    "Routes": {
      "registerRoute": {
        "ClusterId": "securityCluster",
        "Match": {
          "Path": "/security/register"
        },
        "Metadata": {
          "RequireAuthentication": "false"
        }
      },
      "loginRoute": {
        "ClusterId": "securityCluster",
        "Match": {
          "Path": "/security/login"
        },
        "Metadata": {
          "RequireAuthentication": "false"
        }
      },
      "securityRoute": {
        "ClusterId": "securityCluster",
        "Match": {
          "Path": "/security/{**catch-all}"
        },
        "Transforms": [
          {

            "PathRemovePrefix": "/security"
          }
        ],
        "Metadata": {
          "RequireAuthentication": "true"
        }
      },
      "auditRoute": {
        "ClusterId": "auditCluster",
        "Match": {
          "Path": "/audit/{**catch-all}"
        },
        "Metadata": {
          "RequireAuthentication": "true"
        }
      },
      "cryptoRoute": {
        "ClusterId": "cryptoCluster",
        "Match": {
          "Path": "/crypto/{**catch-all}"
        },
        "Transforms": [
          {

            "PathRemovePrefix": "/crypto"
          }
        ],
        "Metadata": {
          "RequireAuthentication": "true"
        }
      }
    },
    "Clusters": {
      "securityCluster": {
        "Destinations": {
          "securityDestination": {
            "Address": "http://localhost:5239/" // URL del microservicio seguridad
          }
        }
      },
      "auditCluster": {
        "Destinations": {
          "auditDestination": {
            "Address": "https://localhost:5002/" // URL del microservicio auditoría
          }
        }
      },
      "cryptoCluster": {
        "Destinations": {
          "auditDestination": {
            "Address": "http://localhost:5001/" // URL del microservicio auditoría
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
